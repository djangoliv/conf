;; (define-key term-raw-map (kbd "C-d") 'delete-char-or-kill-terminal-buffer)
(defun my-term-c-d ()
  (interactive)
  (if (eq major-mode 'term-mode)
      (let ((proc (get-buffer-process (current-buffer))))
        (cond
         ;; pas de process → fermer
         ((not (and proc (process-live-p proc)))
          (when (y-or-n-p (format "Fermer le terminal '%s' ? " (buffer-name)))
            (kill-buffer (current-buffer))))

         ;; ligne contenant @ → prompt shell
         ((save-excursion
            (beginning-of-line)
            (search-forward "@d" (line-end-position) t))
          (if (y-or-n-p "Fermer le terminal ? ")
              ;; on envoie C-d pour fermer le shell proprement
              (term-send-raw-string "\C-d")
            (message "Annulé")))

         ;; sinon → programme interactif (python, etc.)
         (t
          (term-send-raw-string "\C-d"))))
    ;; hors term
    (delete-char 1)))

(define-key term-raw-map (kbd "C-d") 'my-term-c-d)

