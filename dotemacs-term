(defun backward-kill-to-slash ()
  "Kill backward to the previous slash or whitespace on the line.
The delimiter itself is killed, and delimiters sitting right before
point are skipped first, so repeated calls walk up a path one
component at a time.  In `term-mode' char mode the line belongs to
the inferior shell, so send it that many DEL characters instead of
editing the buffer behind its back."
  (interactive)
  (let* ((end (point))
         (bol (line-beginning-position))
         (beg (save-excursion
                (skip-chars-backward "/ \t" bol)
                (skip-chars-backward "^/ \t" bol)
                (when (and (> (point) bol)
                           (memq (char-before) '(?/ ?\s ?\t)))
                  (backward-char))
                (point))))
    (cond
     ((>= beg end) (ding))
     ((and (eq major-mode 'term-mode) (term-in-char-mode))
      (term-send-raw-string (make-string (- end beg) ?\C-?)))
     (t (kill-region beg end)))))
(global-set-key [M-backspace] 'backward-kill-to-slash)

